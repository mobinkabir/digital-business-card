# Local environment / editor
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime-generated admin credentials and secrets
/admin/auth_hash.php
/admin/secrets.php
/admin/secret.php
/admin/deepl_key.php
/admin/db_config.php
/admin/login_attempts.json
/admin/*.log

# User uploads and private documents: only access-control files are tracked
/data/uploads/*
!/data/uploads/.htaccess
/data/resume/*
!/data/resume/.htaccess
/data/views.json
/data/views.json.lock
/data/*.bak
/data/*.log
/data/.panel-errors.log

# Optional third-party font binaries: add only after verifying redistribution rights
/fonts/**/*.woff
/fonts/**/*.woff2
/fonts/**/*.ttf
/fonts/**/*.otf

# Temporary files
*.tmp
*.swp
*.cache
__pycache__/
